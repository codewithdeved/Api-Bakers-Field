    "raw_main": "\n<div class=\"main\">\n            <div class=\"breadcrumbs-box\">\n            <ul class=\"breadcrumbs\">\n                <li class=\"home\"><span typeof=\"v:Breadcrumb\"><a rel=\"v:url\" property=\"v:title\" title=\"Go to EnergyAPI - San Joaquin Valley Chapter.\" href=\"https://www.apibakersfield.com\" class=\"home\">Home</a></span></li>\n<li class=\"post post-page\"><span typeof=\"v:Breadcrumb\"><a rel=\"v:url\" property=\"v:title\" title=\"Go to News &#038; Events.\" href=\"https://www.apibakersfield.com/news-events/\" class=\"post post-page\">News &#038; Events</a></span></li>\n<li class=\"post post-page current-item\"><span typeof=\"v:Breadcrumb\"><span property=\"v:title\">Fall Fun Shoot</span></span></li>\n            </ul>\n        </div>\n    \t\t\t<div class=\"title\"><h1>Fall Fun Shoot</h1></div>\t\t<p><a href=\"https://www.apibakersfield.com/wp-content/uploads/2026/09/2026-API-Fall-Fun-Shoot-Poster_V1.pdf\">2026 Event Flier</a></p>\n<p>&nbsp;</p>\n<p>&nbsp;</p>\n\t\t\t\t</div>\n\t\n\t\t        ",
